# Reverse proxy con HTTPS automatico (Let's Encrypt).
# DOMAIN e LETSENCRYPT_EMAIL arrivano dall'ambiente (vedi .env / docker-compose.yml).

{
	# Email per gli avvisi di Let's Encrypt (scadenza/rinnovo).
	email {$LETSENCRYPT_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd
	# Inoltra tutto a nginx (container "web"), che serve la SPA e fa da proxy
	# verso il server Node per /api, /uploads e il WebSocket Yjs /yjs.
	# Caddy gestisce da solo l'upgrade WebSocket.
	reverse_proxy web:80
}
