# Copia in .env e adatta i valori prima di `docker compose up`.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=canvas_board
MYSQL_USER=canvas
MYSQL_PASSWORD=changeme_app

# --- Server ---
PORT=4000
# Host DB: "db" dentro docker-compose, "localhost" se esegui il server fuori da Docker.
DB_HOST=db
DB_PORT=3306
DB_USER=canvas
DB_PASSWORD=changeme_app
DB_NAME=canvas_board
# Segreto per firmare i JWT. In produzione usa una stringa lunga e casuale.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES=7d
# Limiti upload media
MAX_UPLOAD_MB=25

# --- Client (build-time, letta da Vite) ---
# Vuoto = stesso host via nginx (/api, /socket.io). Imposta solo in dev separato.
VITE_API_BASE=

# --- Reset password (email) ---
# URL pubblico dell'app, usato per costruire il link nell'email di reset.
APP_BASE_URL=http://localhost:8080
# Validità del link di reset, in minuti.
RESET_TOKEN_TTL_MIN=60
# SMTP per l'invio dell'email di reset. Se SMTP_HOST è vuoto, l'email NON viene
# inviata (la richiesta di reset resta comunque accettata, senza inviare nulla):
# la feature è quindi non-bloccante anche senza configurare un server SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@canvasboard.local
